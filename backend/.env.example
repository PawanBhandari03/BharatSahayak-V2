PORT=5000

# Schemes: only records with "verified": true are used. Set true ONLY for local dev/demo
# while the dataset is still being verified (see scheme-data/NEEDS_REVIEW.md).
INCLUDE_UNVERIFIED=false

MISTRAL_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_SID=

# Mistral free tier only allows small models (e.g. open-mistral-nemo); paid tiers can use mistral-large-latest
MISTRAL_MODEL=open-mistral-nemo
